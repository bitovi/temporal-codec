# Local / CI environment for temporal-codec.
# Copy to .env for local runs. Never put real Cloud or AWS secrets in git.

PORT=8080
LOG_LEVEL=debug

# Encryption (gocloud URIs; same schemes as temporal-proxy).
# At least one of ENCRYPTION_URI, ENCRYPTION_URI_TEMPLATE, or ENCRYPTION_URI_OVERRIDES is required.
#
# Local unit/debug (no AWS): testing:// base64-32-byte-key
ENCRYPTION_URI=testing://KioqKioqKioqKioqKioqKioqKioqKioqKioqKioqKio=
#
# Production fleet (preferred): sprintf Cloud short name after JWT authz.
# Decrypt uses only that namespace's KMS alias — never a foreign key.
# ENCRYPTION_URI_TEMPLATE=awskms://alias/platform-managed/%s-codec
#
# Optional per-namespace overrides (break-glass / tests): ns=uri,ns2=uri2
# ENCRYPTION_URI_OVERRIDES=

# Authn — Temporal Cloud UI passAccessToken JWT (public JWKS; no secret needed)
TEMPORAL_CLOUD_JWKS_URL=https://login.tmprl.cloud/.well-known/jwks.json
TEMPORAL_CLOUD_JWT_AUDIENCE=https://saas-api.tmprl.cloud
# TEMPORAL_CLOUD_JWT_ISSUER=
TEMPORAL_NAMESPACE_PERMISSION_CLAIM=permissions
# JWKS_REFRESH_INTERVAL=1h

# Local only: skip JWKS + allow any bearer. Never enable in the cluster.
AUTH_DISABLED=true

# Production surface is decode-only. Set true for local debug of POST /encode.
# ENABLE_ENCODE=false

# Browser Cloud UI only — not an authorization control
CORS_ALLOWED_ORIGINS=https://cloud.temporal.io

# READ_HEADER_TIMEOUT=10s
