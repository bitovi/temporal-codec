# Local / CI environment for temporal-codec (never put real Cloud secrets here).

PORT=8080
LOG_LEVEL=debug

# Envelope encryption — testing:// for unit/local only. Production: awskms://alias/...
# Same scheme temporal-proxy uses (gocloud + pkg/crypto).
ENCRYPTION_URI=testing://KioqKioqKioqKioqKioqKioqKioqKioqKioqKioqKio=
# Optional per-namespace overrides: payments=awskms://alias/platform-managed/payments-codec,...
# ENCRYPTION_URI_OVERRIDES=

# Authn (passAccessToken JWT from Temporal Cloud UI)
TEMPORAL_CLOUD_JWKS_URL=https://login.tmprl.cloud/.well-known/jwks.json
TEMPORAL_CLOUD_JWT_AUDIENCE=https://saas-api.tmprl.cloud
# TEMPORAL_CLOUD_JWT_ISSUER=
TEMPORAL_NAMESPACE_PERMISSION_CLAIM=permissions

# Local only: skip JWKS + allow any bearer. Never enable in the cluster.
AUTH_DISABLED=true

# Production listens on decode only. Set true for local debug of /encode.
# ENABLE_ENCODE=false

# Browser Cloud UI only — not an authorization control
CORS_ALLOWED_ORIGINS=https://cloud.temporal.io
